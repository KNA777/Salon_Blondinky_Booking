# Скопируйте в .env и поменяйте пароль: cp .env.example .env
# Обязательные переменные — без них приложение не стартует (см. app/core/config.py).

# --- PostgreSQL ---
POSTGRES_USER=salon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=salon
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Салон ---
# Часовой пояс салона (настенное время расписания относится к нему).
SALON_TIMEZONE=Europe/Moscow

# --- Telegram-бот ---
# Токен от @BotFather. Нужен только для запуска бота (python -m app.bot).
BOT_TOKEN=123456:ABC-DEF_ghiJKLmnopQRSTUVwxyz

# Webhook-режим (вместо polling). Задайте оба, чтобы бот принимал апдейты через webhook.
# WEBHOOK_URL=https://example.com/webhook/bot
# WEBHOOK_SECRET=придумайте-длинную-случайную-строку

# --- JWT-аутентификация ---
# В продакшене ОБЯЗАТЕЛЬНО замените на длинную случайную строку (есть dev-дефолт).
# JWT_SECRET_KEY=change-me-to-a-long-random-string
# JWT_EXPIRE_MINUTES=1440

# --- Безопасность эксплуатации ---
# dev (по умолчанию) или prod. В prod config.py откажется стартовать, если
# JWT_SECRET_KEY оставлен dev-дефолтом или COOKIE_SECURE=false.
# APP_ENV=dev
# Кука access_token передаётся только по HTTPS. В prod обязательно true.
# COOKIE_SECURE=false

# --- Наблюдаемость (задача 27) ---
# DSN проекта Sentry. Без него Sentry не инициализируется — работает только structlog.
# SENTRY_DSN=https://<key>@<host>/<project-id>
# Доля трассировок, отправляемых в Sentry (0.0–1.0). По умолчанию 0.1.
# SENTRY_TRACES_SAMPLE_RATE=0.1
